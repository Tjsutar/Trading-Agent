# =====================================================================
# T-Agent / Angel One SmartAPI Credentials
# =====================================================================
# Generate API_KEY from https://smartapi.angelbroking.com/
API_KEY=your_smartapi_api_key

# Your Angel One Client Code (e.g. S1234567)
CLIENT_ID=your_client_id

# Your Angel One PIN / Password
PASSWORD=your_pin_or_password

# The TOTP Secret Key from your Authenticator App setup (base32 string)
# Get this when enabling 2FA on SmartAPI/Angel One account
TOTP_SECRET=your_totp_secret_key

# =====================================================================
# Database Configuration (Optional)
# =====================================================================
# Defaults to local SQLite file at data/trading_agent.db if omitted
# DATABASE_URL=postgresql://user:password@localhost:5432/trading_agent
